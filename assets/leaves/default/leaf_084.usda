                float2 inputs:st.connect = </leaf_084/Looks/Top/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
        def Material "Bottom"
        {
            token outputs:surface.connect = </leaf_084/Looks/Bottom/Surface.outputs:surface>

            def Shader "Surface"
