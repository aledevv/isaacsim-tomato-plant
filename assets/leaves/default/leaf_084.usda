                color3f inputs:diffuseColor.connect = </leaf_084/Looks/Top/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_084/Looks/Top/Normal.outputs:rgb>
                float inputs:roughness = 0.45
                float inputs:specularLevel = 0.35
