                color3f inputs:diffuseColor.connect = </leaf_032/Looks/Top/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_032/Looks/Top/Normal.outputs:rgb>
                float inputs:roughness = 0.45
                float inputs:specularLevel = 0.35
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_032_top_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </leaf_032/Looks/Top/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Normal"
