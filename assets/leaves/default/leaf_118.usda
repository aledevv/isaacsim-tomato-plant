    def Scope "Looks"
    {
        def Material "Top"
        {
            token outputs:surface.connect = </leaf_118/Looks/Top/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </leaf_118/Looks/Top/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_118/Looks/Top/Normal.outputs:rgb>
                float inputs:roughness = 0.45
                float inputs:specularLevel = 0.35
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

