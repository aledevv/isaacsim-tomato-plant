    def Scope "Looks"
    {
        def Material "Top"
        {
            token outputs:surface.connect = </leaf_097/Looks/Top/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </leaf_097/Looks/Top/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_097/Looks/Top/Normal.outputs:rgb>
                float inputs:roughness = 0.45
                float inputs:specularLevel = 0.35
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_097_top_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </leaf_097/Looks/Top/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_097_top_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </leaf_097/Looks/Top/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
        def Material "Bottom"
        {
            token outputs:surface.connect = </leaf_097/Looks/Bottom/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </leaf_097/Looks/Bottom/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_097/Looks/Bottom/Normal.outputs:rgb>
                float inputs:roughness = 0.6
                float inputs:specularLevel = 0.35
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_097_bottom_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </leaf_097/Looks/Bottom/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_097_bottom_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </leaf_097/Looks/Bottom/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }
