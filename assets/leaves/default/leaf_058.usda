                asset inputs:file = @./textures/leaf_058_top_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </leaf_058/Looks/Top/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
        def Material "Bottom"
        {
            token outputs:surface.connect = </leaf_058/Looks/Bottom/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </leaf_058/Looks/Bottom/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </leaf_058/Looks/Bottom/Normal.outputs:rgb>
                float inputs:roughness = 0.6
                float inputs:specularLevel = 0.35
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_058_bottom_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </leaf_058/Looks/Bottom/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_058_bottom_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </leaf_058/Looks/Bottom/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }
}
